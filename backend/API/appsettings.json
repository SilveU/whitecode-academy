{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=WhiteCodeAcademy;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;",
    "Redis": "localhost:6379"
  },
  "Redis": {
    "CourseExpirationMinutes": "60",
    "ProfileExpirationMinutes": "60",
    "CoursesExpirationMinutes": "15",
    "DepartmentExpirationMinutes": "120",
    "DepartmentsExpirationMinutes": "30",
    "InstructorExpirationMinutes": "60",
    "InstructorsExpirationMinutes": "15",
    "StudentExpirationMinutes": "60",
    "StudentsExpirationMinutes": "15",
    "SectionExpirationMinutes": "60",
    "SectionsExpirationMinutes": "15",
    "EnrollmentExpirationMinutes": "30",
    "EnrollmentsExpirationMinutes": "10",
    "EmailVerificationExpirationMinutes": "10",
    "EmailVerificationResendCooldownMinutes": "5",
    "ResetPasswordResendCooldownMinutes": "5",
    "AuthTokenActiveCacheMinutes": "60",
    "IdempotencyExpirationMinutes": "30"
  },
  "Audit": {
    "RetentionDays": "1"
  },
  "Hangfire": {
    "CleanUpRefreshToken": "cleanup-refresh-tokens",
    "CleanUpIdempotency": "cleanup-idempotency",
    "CleanUpAuditLogging": "cleanup-auditlogging"
  },
  "ClamAV": {
    "Host": "localhost",
    "Port": "3310"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "ExpireMinutes": ""
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Password": "",
    "FromEmail": "",
    "ReplyTo": "",
    "FromName": "",
    "FrontendBaseUrl": ""
  },
  "CORS": {
    "CorsPolicy": "",
    "AllowedOrigins": [
      "",
      "",
      "",
      ""
    ]
  },
  "FFmpeg": {
    "BinaryFolder": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
        "Microsoft.EntityFrameworkCore.Update": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "SeedSettings": {
    "Admin": {
      "Email": "",
      "UserName": "",
      "FirstName": "System",
      "LastName": "Admin"
    },
    "Instructor": {
      "Email": "",
      "UserName": "",
      "FirstName": "Instructor",
      "LastName": "Instructor"
    },
    "Student": {
      "Email": "",
      "UserName": "",
      "FirstName": "Student",
      "LastName": "Student"
    }
  }
}